generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  OPERATOR
  VIEWER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  IN_TRANSIT
  IN_REPAIR
  RETIRED
  LOST
}

enum MovementType {
  RECEIPT
  DISPATCH
  TRANSFER
  ASSIGNMENT
  RETURN
  STATUS_CHANGE
  ADJUSTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVENTORY_MOVEMENT
  STATUS_CHANGE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements InventoryMovement[]
  auditLogs AuditLog[]

  @@index([role, isActive])
}

model Location {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices       Device[]
  movementsFrom InventoryMovement[] @relation("FromLocation")
  movementsTo   InventoryMovement[] @relation("ToLocation")

  @@index([isActive])
}

model DeviceModel {
  id          String   @id @default(cuid())
  brand       String
  model       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices Device[]

  @@unique([brand, model])
}

model Device {
  id                String       @id @default(cuid())
  internalCode      String       @unique
  serialNumber      String?      @unique
  status            DeviceStatus @default(IN_STOCK)
  imei              String? @unique
  imei2             String? @unique
  modelId           String
  currentLocationId String
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  model           DeviceModel         @relation(fields: [modelId], references: [id], onDelete: Restrict)
  currentLocation Location            @relation(fields: [currentLocationId], references: [id], onDelete: Restrict)
  movements       InventoryMovement[]

  @@index([modelId])
  @@index([currentLocationId, status])
  @@index([createdAt])
}

model InventoryMovement {
  id             String        @id @default(cuid())
  type           MovementType
  deviceId       String
  fromLocationId String?
  toLocationId   String?
  previousStatus DeviceStatus?
  newStatus      DeviceStatus?
  actorId        String
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())

  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  actor        User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@index([deviceId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  actorId    String?
  details    Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
